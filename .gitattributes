# Normalise line endings in the repository to LF. Contributors on Windows get
# CRLF in their working copy; the committed bytes stay consistent.
* text=auto eol=lf

# Explicitly text
*.md        text eol=lf
*.py        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.ts        text eol=lf
CNAME       text eol=lf
LICENSE     text eol=lf

# Binary — never touch
*.png       binary
*.jpg       binary
*.pdf       binary
*.gguf      binary
*.apk       binary
*.aab       binary

# Generated by analysis/compute_model.py and site/build.py. Committed on
# purpose so readers can see the numbers without running Python, but excluded
# from diff noise and language statistics.
docs/figures/*.png   -diff linguist-generated
site/figures/*.png   -diff linguist-generated
analysis/numbers.json  linguist-generated
analysis/NUMBERS.md    linguist-generated
site/whitepaper.html   linguist-generated
