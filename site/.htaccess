# Meridian Moonlight — Apache config for Namecheap shared hosting (cPanel)

# ---------------------------------------------------------------- redirects
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  # Comment this block out until AutoSSL has issued your certificate,
  # otherwise the site will redirect into an error.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: strip www so the site has one address.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------- default doc
DirectoryIndex index.html index.php


# Let AutoSSL validate before any redirect or dotfile rule can interfere.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# ---------------------------------------------------------------- security
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Never serve data files, even if one ends up in the web root by mistake.
<FilesMatch "\.(csv|log|bak|sql|env)$">
  Require all denied
</FilesMatch>

# Hide dotfiles.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Turn off directory listings.
Options -Indexes

# ---------------------------------------------------------------- caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# ---------------------------------------------------------------- error pages
ErrorDocument 404 /index.html
